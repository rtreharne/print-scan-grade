# Copy to .env for a new installation. Replace the secret placeholders below.

# Public hostname only: no https:// or path. HTTPS is assumed.
# For local HTTP development, leave DOMAIN empty and set COOKIE_SECURE=false.
DOMAIN=printscangrade.uniwebdev.co.uk
COOKIE_SECURE=true

# Generate separate random values, for example: openssl rand -hex 32
FLASK_SECRET_KEY=replace-with-a-long-random-session-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Optional: institutional Canvas origin for Canvas LTI registration and NRPS.
# Example: https://your-university.instructure.com
# No personal API token is required.
CANVAS_PUBLIC_BASE_URL=

# Optional local-development origin when DOMAIN is empty.
# TOOL_BASE_URL=http://localhost:8004

# Optional LTI platform bootstrap. Clients can instead be registered through
# /lti/register or configured in /admin/lti. Docker Compose supplies MiniVLE
# defaults for these settings when they are omitted.
# LTI_PLATFORM_ISSUER=https://lms.example.edu
# LTI_PLATFORM_AUTHORIZATION_ENDPOINT=https://lms.example.edu/lti/authorize
# LTI_PLATFORM_JWKS_URL=https://lms.example.edu/lti/jwks
# LTI_PLATFORM_TOKEN_ENDPOINT=https://lms.example.edu/lti/token

# Optional internal platform origin for Docker-only MiniVLE service calls.
# Compose defaults to http://host.docker.internal:8001.
# LTI_INTERNAL_PLATFORM_BASE_URL=http://host.docker.internal:8001
